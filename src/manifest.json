    "lazyCodeLoading": "requiredComponents",
    "optimization": {
      "subPackages": true
    }
  },
  "mp-alipay": {
    "usingComponents": true,
    "component2": true
  },
  "mp-toutiao": {
    "usingComponents": true
  },
  "h5": {
    "title": "uni-app template",
    "router": {
      "mode": "hash",
      "base": "./"
    }
  },
  "uniStatistics": {
    "enable": false
  },
  "vueVersion": "3"
}
