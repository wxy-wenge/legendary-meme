{
  "name": "uni-app-template",
  "appid": "",
  "description": "uni-app (Vue 3 + Vite + TypeScript) 多端小程序工程模板",
  "versionName": "1.0.0",
  "versionCode": "100",
  "transformPx": false,
  "mp-weixin": {
