VITE_ENV=development

# 开发环境走 vite proxy，避免浏览器跨域
VITE_API_BASE_URL=/api
VITE_API_PREFIX=/api
# 若依后端地址（本地 / 局域网联调可复制 .env.local.example 为 .env.local 覆盖）
VITE_PROXY_TARGET=http://127.0.0.1:8080

VITE_DEV_HOST=localhost
VITE_DEV_PORT=5173

# 模拟数据开关：后端接口就绪前设为 true，请求由 src/api/mock.ts 拦截。
# 后端跑起来后改成 false（或在 .env.local 里覆盖）。
VITE_USE_MOCK=true
