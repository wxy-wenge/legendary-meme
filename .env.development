VITE_ENV=development

# 开发环境走 vite proxy，避免浏览器跨域
VITE_API_BASE_URL=/api
VITE_API_PREFIX=/api
# 若依后端地址（本机联调可复制 .env.development.local.example 为 .env.development.local 覆盖）
VITE_PROXY_TARGET=http://127.0.0.1:8080

VITE_DEV_HOST=localhost
VITE_DEV_PORT=5173

# 模拟数据开关：后端接口就绪前设为 true，请求由 src/api/mock.ts 拦截。
# 本机联调不要改这个文件，复制 .env.development.local.example 为
# .env.development.local 再覆盖（原因见 README「多环境变量」）。
VITE_USE_MOCK=true
